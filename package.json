{
  "name": "archive-code-of-heritage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "vitest run",
    "validate:content": "tsx scripts/validate-content.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run validate:content",
    "test:e2e": "playwright test",
    "test:file": "vite build && playwright test -c playwright.file.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/pt-sans": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "phaser": "3.90.0"
  }
}
